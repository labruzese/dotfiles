[user]
    name = Skylar Abruzese
    email = skylar@abruzese.com

[init]
    defaultBranch = main

[core]
    editor = nvim
    autocrlf = input
    pager = less -FRX

[pull]
    rebase = false

[push]
    default = simple
    autoSetupRemote = true

[fetch]
    prune = true

[merge]
    conflictstyle = zdiff3

[diff]
    colorMoved = default

[rerere]
    enabled = true

[color]
    ui = auto

[credential]
    helper = cache --timeout=3600
