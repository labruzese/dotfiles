export ZSH="$HOME/.oh-my-zsh"
export TERM=foot

bindkey -v

autoload -Uz edit-command-line
zle -N edit-command-line
bindkey -M vicmd v edit-command-line

VI_MODE_RESET_PROMPT_ON_MODE_CHANGE=true
KEYTIMEOUT=15
MODE_INDICATOR="%F{blue}%(!.#.$)%f"
INSERT_MODE_INDICATOR="%F{green}%(!.#.$)%f"
VI_MODE_CURSOR_VISUAL=0

plugins=(
    vi-mode
    zsh-syntax-highlighting
    extract
)

HYPHEN_INSENSITIVE="true"
ZSH_THEME="clean"
source $ZSH/oh-my-zsh.sh
PROMPT="\$(vi_mode_prompt_info)$PROMPT"

alias ls='exa --icons'
alias vim='nvim'

HISTSIZE="10000"
SAVEHIST="10000"

HISTFILE="$HOME/.zsh_history"

set_opts=(
  HIST_FCNTL_LOCK HIST_IGNORE_DUPS HIST_IGNORE_SPACE SHARE_HISTORY
  NO_APPEND_HISTORY NO_EXTENDED_HISTORY NO_HIST_EXPIRE_DUPS_FIRST
  NO_HIST_FIND_NO_DUPS NO_HIST_IGNORE_ALL_DUPS NO_HIST_SAVE_NO_DUPS
)

for opt in "${set_opts[@]}"; do
  setopt "$opt"
done
unset opt set_opts

mkdir -p "$(dirname "$HISTFILE")"

eval "$(zoxide init --cmd cd zsh)"

ZSH_HIGHLIGHT_HIGHLIGHTERS=(main)

if [ $UID -eq 0 ]; then NCOLOR="red"; else NCOLOR="white"; fi

PROMPT='$(git_prompt_info)%{$fg[$NCOLOR]%}%B%n@%m%b%{$reset_color%}:%{$fg[blue]%}%B%c/%b%{$reset_color%} $(vi_mode_prompt_info) '
RPROMPT=
# Add vi mode indicator to prompt
PROMPT='%(?.%f.%F{red}<%?>%f)'"$PROMPT"

{{- if eq .machine "desktop" }}

#####################################
# DESKTOP
#####################################

export PATH="$HOME/scripts:$PATH"
[ -f "/home/sky/.ghcup/env" ] && . "/home/sky/.ghcup/env" # ghcup-env

alias trash='gio trash'
alias copy='wl-copy'

[[ ! -r '/home/sky/.opam/opam-init/init.zsh' ]] || source '/home/sky/.opam/opam-init/init.zsh' > /dev/null 2> /dev/null

