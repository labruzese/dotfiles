export ZSH="$HOME/.oh-my-zsh"
export TERM=foot

{{- if eq .machine "desktop" }}
if uwsm check may-start 1>/dev/null && [ -z "${SSH_CONNECTION}" ]; then
    exec uwsm start hyprland.desktop
fi
{{- else if eq .machine "laptop" }}
if uwsm check may-start 1>/dev/null && [ -z "${SSH_CONNECTION}" ]; then
    exec uwsm start hyprland.desktop
fi
{{- end }}
